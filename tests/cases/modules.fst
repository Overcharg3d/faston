import math, random;
import time;
print(math.sqrt(16), math.floor(3.7), math.ceil(3.2), math.floor(-3.5), round(math.pi, 5));
print(round(math.sin(math.pi / 2), 6), round(math.cos(0), 6), round(math.atan2(1, 1), 6), math.hypot(3, 4));
print(math.log(math.e), math.log(8, 2), math.log10(1000), math.degrees(math.pi), math.isnan(math.nan), math.isinf(math.inf));
random.seed(42);
let a = [random.randint(1, 6) for _ in range(20)];
random.seed(42);
let b = [random.randint(1, 6) for _ in range(20)];
print(a == b, min(a) >= 1, max(a) <= 6);
let fs = [random.random() for _ in range(1000)];
print(min(fs) >= 0.0, max(fs) < 1.0, 0.4 < sum(fs) / len(fs) and sum(fs) / len(fs) < 0.6);
let u = random.uniform(5, 10);
print(u >= 5 and u <= 10);
let deck = list(range(10));
random.shuffle(deck);
print(sorted(deck) == list(range(10)), random.choice(["only"]));
let t0 = time.perf_counter();
time.sleep(0.01);
print(time.perf_counter() - t0 >= 0.009, time.time() > 1700000000);
