{
  "name": "faston",
  "displayName": "Faston",
  "description": "Language support for Faston (.fst): highlighting, live compiler errors, IntelliSense, go to definition, rename, formatting, run / build / REPL.",
  "version": "0.2.0",
  "publisher": "overcharg3d",
  "repository": {
    "type": "git",
    "url": "https://github.com/Overcharg3d/faston"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "faston",
    "fst",
    "cranelift"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.fst"
  ],
  "contributes": {
    "languages": [
      {
        "id": "faston",
        "aliases": [
          "Faston",
          "faston"
        ],
        "extensions": [
          ".fst"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/faston.svg",
          "dark": "./icons/faston.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "faston",
        "scopeName": "source.faston",
        "path": "./syntaxes/faston.tmLanguage.json"
      },
      {
        "scopeName": "markdown.faston.codeblock",
        "path": "./syntaxes/faston.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.faston": "faston"
        }
      }
    ],
    "snippets": [
      {
        "language": "faston",
        "path": "./snippets/faston.json"
      }
    ],
    "commands": [
      {
        "command": "faston.run",
        "title": "Run File",
        "category": "Faston",
        "icon": "$(play)"
      },
      {
        "command": "faston.runNative",
        "title": "Run File (Native Code)",
        "category": "Faston",
        "icon": "$(zap)"
      },
      {
        "command": "faston.build",
        "title": "Build Standalone Executable",
        "category": "Faston",
        "icon": "$(package)"
      },
      {
        "command": "faston.showBytecode",
        "title": "Show Bytecode",
        "category": "Faston"
      },
      {
        "command": "faston.openRepl",
        "title": "Open Interactive Prompt (REPL)",
        "category": "Faston",
        "icon": "$(terminal)"
      },
      {
        "command": "faston.sendToRepl",
        "title": "Run Selection in REPL",
        "category": "Faston"
      },
      {
        "command": "faston.buildCompiler",
        "title": "Build the Faston Compiler (cargo build --release)",
        "category": "Faston"
      },
      {
        "command": "faston.selectExecutable",
        "title": "Select Faston Executable…",
        "category": "Faston"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "faston.run",
          "when": "resourceLangId == faston",
          "group": "navigation@0"
        },
        {
          "command": "faston.runNative",
          "when": "resourceLangId == faston",
          "group": "navigation@1"
        },
        {
          "command": "faston.build",
          "when": "resourceLangId == faston",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "faston.run",
          "when": "editorLangId == faston",
          "group": "faston@0"
        },
        {
          "command": "faston.sendToRepl",
          "when": "editorLangId == faston && editorHasSelection",
          "group": "faston@1"
        },
        {
          "command": "faston.showBytecode",
          "when": "editorLangId == faston",
          "group": "faston@2"
        }
      ],
      "explorer/context": [
        {
          "command": "faston.run",
          "when": "resourceLangId == faston",
          "group": "faston@0"
        },
        {
          "command": "faston.build",
          "when": "resourceLangId == faston",
          "group": "faston@1"
        }
      ],
      "commandPalette": [
        {
          "command": "faston.run",
          "when": "editorLangId == faston"
        },
        {
          "command": "faston.runNative",
          "when": "editorLangId == faston"
        },
        {
          "command": "faston.build",
          "when": "editorLangId == faston"
        },
        {
          "command": "faston.showBytecode",
          "when": "editorLangId == faston"
        },
        {
          "command": "faston.sendToRepl",
          "when": "editorLangId == faston"
        }
      ]
    },
    "keybindings": [
      {
        "command": "faston.run",
        "key": "f5",
        "when": "editorLangId == faston && !inDebugMode"
      },
      {
        "command": "faston.runNative",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == faston && !inDebugMode"
      },
      {
        "command": "faston.sendToRepl",
        "key": "shift+enter",
        "when": "editorLangId == faston && editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Faston",
      "properties": {
        "faston.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `faston` executable. When empty, the extension looks for `target/release/faston` (then `target/debug`) in the workspace, then `faston` on your `PATH`."
        },
        "faston.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Check Faston files with the real compiler and show syntax errors in the editor."
        },
        "faston.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Check while typing (otherwise only when a file is opened or saved)."
        },
        "faston.diagnostics.delay": {
          "type": "number",
          "default": 350,
          "minimum": 50,
          "description": "Milliseconds to wait after the last keystroke before checking."
        },
        "faston.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Extra editor warnings: Python habits that don't work in Faston (__init__, super()), unknown imports."
        },
        "faston.run.native": {
          "type": "boolean",
          "default": false,
          "description": "Make 'Run File' (F5) compile to native code instead of using the interpreter."
        },
        "faston.run.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the file (and other dirty Faston files) before running or building."
        },
        "faston.run.clearTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Clear the terminal before each run."
        },
        "faston.inlayHints.parameterNames": {
          "type": "boolean",
          "default": false,
          "description": "Show parameter names before literal arguments at call sites."
        }
      }
    },
    "configurationDefaults": {
      "[faston]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "taskDefinitions": [
      {
        "type": "faston",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build"
            ],
            "description": "run: run the file, build: make a standalone executable."
          },
          "file": {
            "type": "string",
            "description": "The .fst file (default: the active editor's file). Variables like ${file} work."
          },
          "native": {
            "type": "boolean",
            "description": "For 'run': compile to native code first."
          },
          "output": {
            "type": "string",
            "description": "For 'build': name of the executable (-o)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra command-line arguments."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "faston",
        "label": "Faston errors",
        "owner": "faston",
        "source": "faston",
        "fileLocation": [
          "relative",
          "${fileDirname}"
        ],
        "pattern": [
          {
            "regexp": "^\\s+File \"(.+?)\", line (\\d+), in .*$",
            "file": 1,
            "line": 2
          },
          {
            "regexp": "^([A-Za-z_]\\w*): (.*)$",
            "code": 1,
            "message": 2
          }
        ]
      },
      {
        "name": "faston-import",
        "label": "Faston errors in imported modules",
        "owner": "faston",
        "source": "faston",
        "fileLocation": [
          "relative",
          "${fileDirname}"
        ],
        "pattern": {
          "regexp": "^File \"(.+?)\": \\[line (\\d+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      }
    ]
  }
}
